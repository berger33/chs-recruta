APP_ENV=development
DATABASE_URL=sqlite:///./chs_recruta.db
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AUTO_CREATE_SCHEMA=true

# Preencha localmente; nunca versione os valores reais.
POSTGRES_PASSWORD=
SECURITY_SECRET_KEY=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_USERNAME=demo
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
MAX_ACTIVE_SESSIONS=5

PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RESET_URL=http://127.0.0.1:8000/#reset_token={token}
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

TUTORIAL_VERSION=5
SEED_DEMO=false
